{
  "name": "picoDevice",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "picoDevice",
  "targets": {
    "configure": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/configure.sh",
        "cwd": "picoDevice"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/build.sh",
        "cwd": "picoDevice"
      },
      "configurations": {
        "debug": {
          "env": { "PICO_BUILD_TAGS": "picodebug" }
        }
      },
      "dependsOn": ["configure"],
      "inputs": [
        "default",
        "^default",
        {
          "runtime": "sha256sum picoDevice/.env 2>/dev/null || echo no-env"
        }
      ],
      "outputs": ["{projectRoot}/dist"]
    },
    "upload": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash tools/build.sh flash",
        "cwd": "picoDevice"
      },
      "configurations": {
        "debug": {
          "env": { "PICO_BUILD_TAGS": "picodebug" }
        }
      },
      "dependsOn": ["configure"]
    },
    "monitor": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tinygo monitor",
        "cwd": "picoDevice"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": [],
      "options": {
        "command": "echo 'picoDevice has no tests: it is a single TinyGo main package bound to Pico 2 W hardware. Put testable logic in inky/util.'",
        "cwd": "picoDevice"
      }
    }
  }
}
