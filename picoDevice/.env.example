# WiFi Configuration
WIFI_SSID=your_wifi_network_name
WIFI_PASSWORD=your_wifi_password

# API Configuration
# Base URL of the API: scheme://host[:port][/path-prefix]
# Host names are resolved via DNS; an IP literal skips DNS. https:// validates
# the server certificate against the embedded Let's Encrypt roots and waits for
# the NTP-synced clock.
# Local dev against `pnpm nx run api:serve` on your machine (plain http, port
# 8080; an IP literal skips DNS):
API_URL=http://192.168.1.100:8080
# A deployment, e.g. behind a reverse proxy (https):
# API_URL=https://dashboard.example.com

# DNS server used only if DHCP offers none (optional, IPv4 literal).
# DNS_SERVER=192.168.1.1

# NTP server for the wall clock (host name or IPv4 literal; default
# pool.ntp.org). Certificate validation needs the time, plain http does not.
# NTP_SERVER=pool.ntp.org

# Refresh Configuration (seconds)
# Time between fetches when the server sends no X-Refresh-After delay.
REFRESH_INTERVAL=60
# Bounds for the server's delay (defaults 120 and 14400 = 4 h).
# MIN_REFRESH_INTERVAL=120
# MAX_REFRESH_INTERVAL=14400

# ---- Debug builds only (pnpm nx run picoDevice:upload:debug) ----
# Release builds ignore everything below; leave it unset.

# Hardware test knobs for WiFi retry.
# Fail the first N joins at boot by joining a non-existent SSID.
# WIFI_TEST_FAIL_JOINS=3
# After refresh cycle K, leave the access point (by joining the missing SSID)
# and fail the next M joins, simulating an access point outage.
# WIFI_TEST_OUTAGE_AFTER_CYCLE=2
# WIFI_TEST_OUTAGE_FAIL_JOINS=3

# Memory test knobs.
# Re-sync the clock every N seconds instead of every 12 hours.
# NTP_TEST_SYNC_INTERVAL=120
# Run the GC before each cycle's memory stats, so heapAlloc is the live heap,
# and log the main goroutine's stack headroom.
# MEM_TEST_GC=true
