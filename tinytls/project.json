{
  "name": "tinytls",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tinytls",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "go build ./...",
        "cwd": "tinytls"
      }
    },
    "build:tinygo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tinygo build -target=pico2-w -o /dev/null ./cmd/tinygocheck",
        "cwd": "tinytls"
      }
    },
    "test:tinygo": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tinygo test ./ ./roots",
        "cwd": "tinytls"
      }
    }
  }
}
